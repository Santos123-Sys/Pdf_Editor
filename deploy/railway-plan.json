{
  "description": "Deployment intent for Railway tooling; this is not an automatically applied IaC file.",
  "projectName": "Papertrail PDF",
  "workspaceId": "527509ec-1d77-475a-a71e-bfdce1ba282b",
  "environment": "production",
  "repository": "Santos123-Sys/Pdf_Editor",
  "branch": "main",
  "region": "europe-west4-drams3a",
  "services": {
    "Postgres": {
      "template": "postgres",
      "privateOnly": true,
      "persistentVolume": "/var/lib/postgresql/data",
      "credentialPolicy": "Use Railway template-generated credentials. Do not commit or print them."
    },
    "api": {
      "rootDirectory": "/api",
      "dockerfilePath": "Dockerfile",
      "healthcheckPath": "/health",
      "healthcheckTimeout": 300,
      "privateOnly": true,
      "privateNetworkEndpoint": "api",
      "replicas": 1,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "persistentVolume": {"mountPath": "/data", "sizeMB": 5000},
      "variables": {
        "PORT": "8000",
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "STORE_DIR": "/data",
        "APP_PUBLIC_URL": "https://${{web.RAILWAY_PUBLIC_DOMAIN}}",
        "CORS_ORIGINS": "https://${{web.RAILWAY_PUBLIC_DOMAIN}}"
      }
    },
    "web": {
      "rootDirectory": "/web",
      "dockerfilePath": "Dockerfile",
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 300,
      "publicDomain": true,
      "replicas": 1,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "generatedSecrets": ["WORKSPACE_PASSWORD"],
      "variables": {
        "PORT": "3000",
        "HOSTNAME": "0.0.0.0",
        "API_INTERNAL_URL": "http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8000",
        "REQUIRE_WORKSPACE_PASSWORD": "1",
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    }
  }
}
